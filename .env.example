# VeriPay environment template.
#
# Copy to `.env` and fill in real values locally. This file lists NAMES AND
# EXPLANATIONS ONLY — never commit a value, real or placeholder, to it.
#
# `.env` is git-ignored. The Supabase entries below are provisioned by
# Stripe Projects (`stripe projects env --pull`), not written by hand.

# =============================================================================
# Runtime
# =============================================================================

# development | test | production
NODE_ENV=

# Port the API listens on. Defaults to 8787.
API_PORT=

# Comma-separated CORS allowlist of browser origins, e.g. the local web app on
# http://localhost:5173. Must be absolute http(s) origins with no path.
# Wildcards are never accepted.
WEB_ORIGIN=

# Absolute base URL the API is reachable at. Defaults to http://localhost:8787.
API_BASE_URL=

# fatal | error | warn | info | debug | trace | silent. Defaults to info.
LOG_LEVEL=

# Milliseconds the graceful shutdown may take before the process is forced
# down. Defaults to 10000.
SHUTDOWN_GRACE_MS=

# =============================================================================
# Supabase (provisioned by Stripe Projects)
#
# There is deliberately NO generic DATABASE_URL. Supabase exposes this project
# through two connections that are not interchangeable, and using the wrong one
# fails only under load or mid-migration.
# =============================================================================

# Supavisor TRANSACTION POOLER (port 6543). Used by the long-running API
# runtime client. Prepared statements are disabled on this connection because
# consecutive statements may land on different backends.
SUPABASE_POOLER_URL=

# DIRECT connection (port 5432). Used by drizzle-kit for `db:generate` and
# `db:migrate` only. DDL and migration advisory locks need it; never use it for
# the API runtime.
SUPABASE_DB_URL=

# Remaining Supabase provisioning metadata.
SUPABASE_DB_PASS=
SUPABASE_PROJECT_REF=
SUPABASE_PROJECT_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ORG_SLUG=
SUPABASE_PLAN=

# =============================================================================
# Auth0 — authentication only, for REGISTERED VeriPay accounts
#
# Auth0 establishes WHO the caller is. VeriPay decides what they may do.
# Never treat an Auth0 claim as an application permission.
#
# Guest link recipients never sign in to Auth0 and never get an account.
#
# AUTH0_DOMAIN / AUTH0_CLIENT_ID / AUTH0_CLIENT_SECRET are generated by
# Stripe Projects (`stripe projects env --pull`). AUTH0_AUDIENCE is NOT — the
# catalog has no API/resource-server service, so you create the API by hand in
# the Auth0 dashboard. See docs/auth0.md.
# =============================================================================

# Tenant domain, no scheme, e.g. veripay.us.auth0.com  [Stripe Projects]
AUTH0_DOMAIN=

# API identifier the access token must be audienced for. Create the API in the
# Auth0 dashboard as "VeriPay API" with identifier https://api.veripay and
# signing algorithm RS256. This is an audience string, not a deployed URL.
AUTH0_AUDIENCE=

# SPA client id. Public — safe to mirror into VITE_AUTH0_CLIENT_ID.  [Stripe Projects]
AUTH0_CLIENT_ID=

# Confidential-client credential.  [Stripe Projects]
# UNUSED by VeriPay: the SPA access-token flow is public-key only (RS256 +
# JWKS), so nothing verifies tokens with this. Server-side only — it must never
# be mirrored into a VITE_ variable, which would publish it to every visitor.
AUTH0_CLIENT_SECRET=

# =============================================================================
# Stripe
#
# Stripe webhooks are the authoritative source of payment state. A client
# redirect back from Checkout is a UI hint, never a reason to mark a payment
# complete.
# =============================================================================

# Secret API key. Server-side only.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint. Every webhook must be signature
# verified before it is trusted.
STRIPE_WEBHOOK_SECRET=

# Where Stripe returns the user after Connect onboarding completes / expires.
STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=

# =============================================================================
# Application
# =============================================================================

# Public base URL of the deployed app, used to build user-facing links.
APP_BASE_URL=

# Secret used to hash opaque tokens before they are stored. Minimum 32
# characters. Rotating it invalidates every existing token.
TOKEN_HASH_SECRET=

# =============================================================================
# Browser build
#
# Only VITE_-prefixed variables are exposed to the web bundle. Everything here
# ships to the browser in plain text — never put a secret in this section.
# =============================================================================

# API base URL the web app calls. Defaults to http://localhost:8787.
VITE_API_BASE_URL=

# Auth0 SPA settings. Copy these across by hand — Stripe Projects generates the
# unprefixed AUTH0_* names, and Vite only exposes VITE_-prefixed variables to
# the browser. All three must be set together or the app shows an
# "Auth0 is not configured" notice instead of a login button.
#
# There is deliberately no VITE_ entry for the Auth0 client secret, and there
# never can be one — see docs/auth0.md.

# Same value as AUTH0_DOMAIN.
VITE_AUTH0_DOMAIN=

# Same value as AUTH0_CLIENT_ID. A public client id is not a secret.
VITE_AUTH0_CLIENT_ID=

# Same value as AUTH0_AUDIENCE, i.e. https://api.veripay
VITE_AUTH0_AUDIENCE=
