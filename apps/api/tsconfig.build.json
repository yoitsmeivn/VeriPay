{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@veripay/config/tsconfig.node.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts"],
  // Test-only code must never reach dist/.
  "exclude": ["src/**/*.test.ts", "src/**/__fixtures__/**"]
}
